            "normalizedKey",
            "origin",
            "provenance",
            "scope",
            "scopeId",
            "state",
            "updatedAt"
          ],
          "type": "object"
        },
        "MemoryEntryId": {
          "type": "string"
        },
        "MemoryKind": {
          "description": "Approved semantic kind for a memory entry.",
          "enum": [
            "preference",
            "feedback",
            "fact",
            "reference"
          ],
          "type": "string"
        },
        "MemoryOrigin": {
          "description": "Origin of a memory entry.",
          "enum": [
            "explicit_user",
            "inferred_session"
          ],
          "type": "string"
        },
        "MemoryProvenance": {
          "description": "Provenance summary safe to return with a memory entry.",
          "properties": {
            "sourceSessionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceTurnId": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceUserItemId": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ItemId"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        "MemoryScope": {
          "description": "Scope that owns a memory entry.",
          "oneOf": [
            {
              "description": "Memory shared by the current user across projects.",
              "enum": [
                "user"
              ],
              "type": "string"
            },
            {
              "description": "Memory associated with the current project identity.",
              "enum": [
                "project"
              ],
              "type": "string"
            }
          ]
        },
        "MemoryState": {
          "description": "Lifecycle state of a memory entry.",
          "oneOf": [
            {
              "enum": [
                "active",
                "stale",
                "conflicted",
                "retired"
              ],
              "type": "string"
            },
            {
              "description": "An explicitly remembered identity that was previously retired.",
              "enum": [
                "restored"
              ],
              "type": "string"
            }
          ]
        }
      },
      "description": "Result of a memory forget request.\n\n`forgotten` is populated only after an exact identity was retired. `candidates` is populated for an ambiguous text request and signals that the caller must select an entry ID before retrying.",
